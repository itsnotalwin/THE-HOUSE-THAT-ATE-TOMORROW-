; Godot 4.6.3 — first playable slice.
config_version=5

[application]
config/name="The House That Ate Tomorrow"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Tomorrow is missing. The cat denies everything."
config/icon="res://assets/icon_home.png"
boot_splash/image="res://assets/title_wordmark.png"
boot_splash/bg_color=Color(0.067, 0.063, 0.11, 1)

[autoload]
GameState="*res://scripts/state.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.067, 0.063, 0.11, 1)
2d/snap/snap_2d_transforms_to_pixel=true

[audio]
driver/enable_input=false

[filesystem]
import/blender/enabled=false
